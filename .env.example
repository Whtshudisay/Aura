# Supabase — Project Settings → API
#
# NEXT_PUBLIC_* values are embedded in the browser bundle.
# Only the project URL and the anon/public key belong here.
# Never put the service_role key (or any secret) in a NEXT_PUBLIC_ variable.
#
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# If you add server-only secrets later (e.g. SUPABASE_SERVICE_ROLE_KEY),
# omit the NEXT_PUBLIC_ prefix so they stay on the server.
